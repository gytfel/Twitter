# =============================================================
#  Скопируй этот файл в .env и заполни своими значениями:
#      cp .env.example .env
#  Файл .env НИКОГДА не коммить в git.
# =============================================================

# --- Способ авторизации ---
# oauth1 — токен не протухает, обновлять нечего. Предпочтительно, если доступен.
# oauth2 — токен живёт ~2 часа, бот сам обновляет его по refresh token.
AUTH_MODE=oauth2

# --- Ключи X (Twitter) API ---
# Берутся в developer.x.com → Projects & Apps → твоё приложение → Keys and tokens
# ВАЖНО: в настройках приложения User authentication settings должны стоять
# права "Read and Write". Если менял права — ПЕРЕВЫПУСТИ Access Token.

# Нужны при AUTH_MODE=oauth1 (блок Consumer Keys + Access Token and Secret)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Нужны при AUTH_MODE=oauth2 (блок "OAuth 2.0 Client ID and Client Secret")
X_CLIENT_ID=
X_CLIENT_SECRET=
# Стартовый refresh token из авторизации. Нужен только для первого запуска:
# дальше бот хранит актуальный в token.json, потому что X меняет refresh token
# при каждом обновлении и гасит старый.
# Требуемые scope: tweet.read tweet.write users.read offline.access
X_REFRESH_TOKEN=

# Аккаунт, в который должны уходить посты — без @.
# На публикацию НЕ влияет: пост уйдёт туда, чьим Access Token подписан запрос.
# Нужен только для `python main.py check` — он сверит и предупредит,
# если токены выпущены под другим аккаунтом.
X_USERNAME=gytfel1

# --- Откуда брать тексты постов ---
# file = ротация готовых постов из posts.txt (бесплатно, полный контроль)
# ai   = генерация через Claude API (нужен ключ ниже)
CONTENT_MODE=file

# --- Настройки генерации (нужны только при CONTENT_MODE=ai) ---
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5
ACCOUNT_TOPIC=разработка, автоматизация и ИИ-инструменты
ACCOUNT_TONE=разговорный, коротко, без канцелярита, без хэштегов
POST_LANGUAGE=русский

# --- Расписание (локальное время сервера) ---
POSTS_PER_DAY=3
ACTIVE_HOURS=10,15,20
JITTER_MINUTES=25

# --- Предохранители ---
# Жёсткий потолок постов в сутки. Даже если что-то пойдёт не так — больше не уйдёт.
MAX_POSTS_PER_DAY=5
# true = всё работает, но твит НЕ отправляется. Для тестов.
DRY_RUN=true
